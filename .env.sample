# PO,RR local/server environment sample
# Copy this file to .env and replace placeholder values.

# Admin account IDs (comma-separated; use login IDs, not email addresses)
PORR_ADMIN_USERS=admin

# Optional: sheet-drive super users (comma-separated login IDs)
PORR_SUPER_USERS=admin

# Data directory
PORR_DATA_DIR=./out

# Local HTTP development
PORR_HTTPS=false
PORR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password recovery approval link
PORR_PUBLIC_BASE_URL=http://localhost:8010
PORR_PASSWORD_RESET_TTL_HOURS=48

# SMTP settings for password recovery emails
# Leave PORR_SMTP_HOST empty to disable email sending in local development.
PORR_SMTP_HOST=
PORR_SMTP_PORT=587
PORR_SMTP_USER=
PORR_SMTP_PASSWORD=
PORR_SMTP_FROM=no-reply@porr.app
PORR_SMTP_USE_TLS=true

# Optional legacy GUI setting
# PORR_EDIT_PASSWORD=change-me

# Optional upload limit in MB
# PORR_MAX_UPLOAD_MB=50
